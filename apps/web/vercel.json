{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "source-watch/report": false,
      "redesign-and-data-expansion": false
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../../packages ../../content ../../data ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml"
}
