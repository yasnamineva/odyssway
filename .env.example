# --- Site (Phase 1) ---
# Canonical site origin used in sitemap.xml/robots.txt, e.g. "https://odyssway.example"
NEXT_PUBLIC_SITE_URL=

# --- Analytics (Phase 1) ---
# Plausible domain, e.g. "odyssway.example". Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Anonymous tool counts (optional) ---
# Upstash Redis REST credentials (free tier is enough). If unset, /api/count only
# writes to the hosting log, which keeps entries for about a day.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Phase 2 (accounts / alerts) — not used yet ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# RESEND_API_KEY=
